{
  "openapi": "3.0.2",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/execute_bash": {
      "post": {
        "summary": "Execute Bash Script",
        "description": "Executes arbitrary shell command from POST request.",
        "operationId": "execute_bash_script_execute_bash_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecuteBashRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/execute_python": {
      "post": {
        "summary": "Execute Python Script",
        "description": "Executes Python code from POST request.\n\nUnlike /execute_bash which spawns a new subprocess per call (stateless),\nthis endpoint runs code via exec() in a persistent in-memory namespace\n(_PYTHON_EXEC_SCOPE), so variables and imports survive across calls\n(stateful session).",
        "operationId": "execute_python_script_execute_python_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutePythonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/save_file": {
      "post": {
        "summary": "Save File",
        "description": "Saves base64-encoded content to a file in the drive_files directory.",
        "operationId": "save_file_save_file_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveFileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/fetch_file": {
      "post": {
        "summary": "Fetch File",
        "description": "Reads a file from the drive_files directory and returns its base64-encoded content.",
        "operationId": "fetch_file_fetch_file_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FetchFileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExecuteBashRequest": {
        "title": "ExecuteBashRequest",
        "required": [
          "command"
        ],
        "type": "object",
        "properties": {
          "command": {
            "title": "Command",
            "type": "string"
          }
        }
      },
      "ExecutePythonRequest": {
        "title": "ExecutePythonRequest",
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          }
        }
      },
      "FetchFileRequest": {
        "title": "FetchFileRequest",
        "required": [
          "file_path"
        ],
        "type": "object",
        "properties": {
          "file_path": {
            "title": "File Path",
            "type": "string"
          }
        }
      },
      "HTTPValidationError": {
        "title": "HTTPValidationError",
        "type": "object",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "SaveFileRequest": {
        "title": "SaveFileRequest",
        "required": [
          "content",
          "file_path"
        ],
        "type": "object",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "file_path": {
            "title": "File Path",
            "type": "string"
          }
        }
      },
      "ValidationError": {
        "title": "ValidationError",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "type": "object",
        "properties": {
          "loc": {
            "title": "Location",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        }
      }
    }
  }
}
